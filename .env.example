# BLUE LETTER — Example Environment Variables (Do NOT commit real secrets)
HOST=127.0.0.1
PORT=8080

# Initial server-side Admin setup credentials (used only on first DB initialization)
ADMIN_EMAIL=admin@blueletter.local
ADMIN_INITIAL_PASSWORD=ChangeMeBeforeProduction!

# Optional custom storage paths
# BLUE_LETTER_DATA_DIR=./data
# BLUE_LETTER_MEDIA_DIR=./media

# Enable Secure cookie attribute when deployed behind HTTPS proxy
COOKIE_SECURE=0
